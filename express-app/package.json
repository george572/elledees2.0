{
  "name": "express-app",
  "version": "1.0.0",
  "description": "Express.js app with EJS and Tailwind CSS",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"nodemon server.js\" \"npm run watch:css\"",
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch"
  },
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.0"
  }
}
