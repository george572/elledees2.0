              <button type="button" class="salad-name-btn text-left font-cardinal text-ed-green text-[20px] md:text-[48px] uppercase leading-[22px] md:leading-[40px] hover:text-ed-yellow transition-colors cursor-pointer bg-transparent border-none p-0" data-salad-id="mexican-dream" data-price="14.90">Mexican <br/> Dream</button>
