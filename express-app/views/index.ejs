         <div class="flex flex-col md:flex-row overflow-x-auto gap-2 md:gap-3 justify-start md:justify-center mb-8 md:mb-10 pb-1 scrollbar-hide">
           <button class="location-chip active" onclick="switchLocation(this)">Elle&amp;Dee&rsquo;s &mdash; Notre-Dame-de-Lorette<br><span class="text-[9px] md:text-[10px] opacity-70">1 rue Bourdaloue 75009</span></button>
           <button class="location-chip" onclick="switchLocation(this)">Elle&amp;Dee&rsquo;s &mdash; Washington<br><span class="text-[9px] md:text-[10px] opacity-70">30 rue Washington 75008</span></button>
           <button class="location-chip" onclick="switchLocation(this)">Elle&amp;Dee&rsquo;s &mdash; Neuilly<br><span class="text-[9px] md:text-[10px] opacity-70">151 avenue Charles de Gaulle 92200</span></button>
         </div>
       </div>

      <!-- Tab navigation -->
      <div class="flex overflow-x-auto gap-2 md:gap-3 justify-start md:justify-center mb-10 md:mb-10 mt-10 pb-1 scrollbar-hide">
        <button data-tab="signature" class="menu-tab active" onclick="switchMenuTab('signature')">Signature Salads</button>
