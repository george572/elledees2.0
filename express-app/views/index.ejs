<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Elle&Dee's</title>
  <link href="/css/output.css" rel="stylesheet">
</head>
<body class="min-h-screen">
  <!-- Header: Desktop -->
  <header class="hidden md:flex gap-6 lg:gap-8 items-center justify-center py-6 mx-auto sticky top-0 z-40 bg-white h-[84px]">
    <a href="https://elledees.zelty-order.fr/" target="_blank" rel="noopener noreferrer" class="font-geomanist-bold uppercase text-ed-green text-[14px] lg:text-[19px] transition-colors hover:text-ed-yellow cursor-pointer translate-y-0.5">Click & Collect</a>
    <a href="#menu" class="font-geomanist-bold uppercase text-ed-green text-[14px] lg:text-[19px] transition-colors hover:text-ed-yellow cursor-pointer translate-y-0.5">Menu</a>
    <a href="#hero" class="flex-shrink-0">
      <img src="/images/logo.svg" alt="Elle&amp;Dee's" class="w-[180px] lg:w-[220px] h-auto">
    </a>
    <a href="#aboutus" class="font-geomanist-bold uppercase text-ed-green text-[14px] lg:text-[19px] transition-colors hover:text-ed-yellow cursor-pointer translate-y-0.5">About Us</a>
    <a href="#contact" class="font-geomanist-bold uppercase text-ed-green text-[14px] lg:text-[19px] transition-colors hover:text-ed-yellow cursor-pointer translate-y-0.5">Contact</a>
    <div class="absolute right-8 lg:right-12 flex items-center gap-1 font-geomanist-bold text-ed-green text-[14px] lg:text-[19px] uppercase">
      <span id="lang-display">EN</span>
