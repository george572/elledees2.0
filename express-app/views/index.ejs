              <div class="space-y-1.5 text-[13px] text-ed-dark/70 font-geomanist-bold">
                <div class="flex justify-between"><span>Calories</span><span>420 kcal</span></div>
                <div class="flex justify-between"><span>Protein</span><span>18g</span></div>
                <div class="flex justify-between"><span>Carbs</span><span>42g</span></div>
                <div class="flex justify-between"><span>Fat</span><span>22g</span></div>
                <div class="flex justify-between"><span>Fiber</span><span>8g</span></div>
              </div>
              <button type="button" onclick="toggleNutrition(this)" class="mt-auto h-[40px] flex items-center justify-center border-2 border-ed-green text-ed-green text-[12px] font-geomanist-bold uppercase tracking-wide rounded-full hover:bg-ed-green/5 transition-colors min-h-[40px]">Close</button>
            </div>
          </div>
        </div>

        <!-- Salad 2 -->
        <div class="salad-card">
          <div class="aspect-[4/3] overflow-hidden rounded-2xl relative">
            <div class="absolute top-4 left-4 z-10 bg-ed-red text-ed-beige font-geomanist-bold text-[10px] md:text-[11px] uppercase tracking-[0.15em] px-3 py-1 rounded-full">Chef&rsquo;s Pick</div>
            <img src="/images/ave-cesar.webp" alt="Avocado Royale" class="w-full h-full object-cover">
          </div>
          <div class="mt-4 relative overflow-hidden min-h-[240px]">
            <div>
