    <a href="#hero">
      <img src="/images/logo.svg" alt="Elle&amp;Dee's" class="w-[150px] sm:w-[180px] h-auto cursor-pointer">
    </a>
    <div class="flex items-center gap-3">
      <div class="font-geomanist-bold text-ed-green text-[14px] uppercase"><span id="lang-display-mob">EN</span></div>
      <button type="button" id="burger-btn" class="nav-burger-menu focus:outline-none" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span><span></span>
