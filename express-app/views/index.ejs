              <button type="button" onclick="toggleNutrition(this)" class="mt-auto h-[40px] flex items-center justify-center border-2 border-ed-green text-ed-green text-[12px] font-geomanist-bold uppercase tracking-wide rounded-full hover:bg-ed-green/5 transition-colors min-h-[40px]">Close</button>
            </div>
          </div>
        </div>

        <!-- Salad 3 -->
        <div class="salad-card">
          <div class="aspect-[4/3] overflow-hidden rounded-2xl">
            <img src="/images/big-crispy.webp" alt="Caesar Reimagined" class="w-full h-full object-cover">
          </div>
          <div class="mt-4 relative overflow-hidden min-h-[240px]">
            <div>
              <h3 class="font-cardinal text-ed-dark text-[22px] md:text-[24px] leading-tight">Caesar Reimagined</h3>
              <p class="text-[14px] text-ed-dark/60 mt-3 leading-relaxed">The timeless classic, elevated with shaved parmesan, house-made croutons, and a bold anchovy dressing.</p>
              <p class="font-cardinal text-ed-green text-[20px] mt-4">13.50&euro;</p>
              <div class="flex gap-3 mt-4">
                <a href="https://elledees.zelty-order.fr/" target="_blank" rel="noopener noreferrer" class="flex-1 h-[40px] flex items-center justify-center bg-ed-green text-white text-[12px] font-geomanist-bold uppercase tracking-wide rounded-full hover:bg-ed-green/90 transition-colors">Order</a>
                <button type="button" onclick="toggleNutrition(this)" class="flex-1 h-[40px] flex items-center justify-center border-2 border-ed-green text-ed-green text-[12px] font-geomanist-bold uppercase tracking-wide rounded-full hover:bg-ed-green/5 transition-colors">Nutrition Info</button>
              </div>
            </div>
            <div class="nutrition-panel absolute inset-0 bg-ed-beige rounded-xl p-5 pt-0 md:p-6 md:pt-0 translate-y-full transition-transform duration-300 ease-out flex flex-col">
              <h4 class="font-cardinal text-ed-dark text-[18px] mb-3">Nutrition Info</h4>
              <div class="space-y-1.5 text-[13px] text-ed-dark/70 font-geomanist-bold">
                <div class="flex justify-between"><span>Calories</span><span>380 kcal</span></div>
                <div class="flex justify-between"><span>Protein</span><span>22g</span></div>
                <div class="flex justify-between"><span>Carbs</span><span>28g</span></div>
                <div class="flex justify-between"><span>Fat</span><span>18g</span></div>
                <div class="flex justify-between"><span>Fiber</span><span>6g</span></div>
              </div>
              <button type="button" onclick="toggleNutrition(this)" class="mt-auto h-[40px] flex items-center justify-center border-2 border-ed-green text-ed-green text-[12px] font-geomanist-bold uppercase tracking-wide rounded-full hover:bg-ed-green/5 transition-colors min-h-[40px]">Close</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Full Menu -->
  <section id="menu" class="bg-white py-16 md:py-7 px-2">
    <div class="w-[98%] mx-auto bg-ed-beige rounded-3xl shadow-xl px-5 md:px-10 lg:px-14 py-16 md:py-20">

      <!-- Section header -->
      <div class="text-center mb-10">
        <span class="font-geomanist-bold uppercase text-ed-red text-[11px] md:text-[13px] tracking-[0.25em]">Explore</span>
        <h2 class="font-cardinal text-ed-red text-[48px] md:text-[72px] leading-[1] mt-2 uppercase">Our Menu</h2>
        <div class="w-12 h-[3px] bg-ed-red/30 mx-auto mt-5"></div>
      </div>

      <!-- Location chips -->
