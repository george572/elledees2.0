      <div id="panel-signature" class="menu-panel active">
        <div class="flex items-center gap-3 mb-8">
          <h3 class="font-cardinal text-ed-red text-[30px] md:text-[120px] uppercase leading-[1]">Signature Salads</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-x-16 md:gap-y-10">

          <div class="menu-item">
            <div class="flex items-baseline justify-between gap-2">
              <button type="button" class="salad-name-btn text-left font-cardinal text-ed-green text-[20px] md:text-[48px] uppercase leading-[22px] md:leading-[40px] hover:text-ed-yellow transition-colors cursor-pointer bg-transparent border-none p-0" data-salad-id="ave-cesar" data-price="15.90">AVE <br/> CESAR</button>
