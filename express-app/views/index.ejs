          </div>

          <div class="menu-item">
            <div class="flex items-baseline justify-between gap-2">
              <button type="button" class="salad-name-btn text-left font-cardinal text-ed-green text-[20px] md:text-[48px] uppercase leading-[22px] md:leading-[40px] hover:text-ed-yellow transition-colors cursor-pointer bg-transparent border-none p-0" data-salad-id="tangerine-crunch" data-price="14.90">Tangerine <br/> Crunch</button>
              <span class="font-cardinal text-ed-green text-[18px] md:text-[48px]">14.90</span>
            </div>
            <p class="text-[18px] font-geomanist-bold tracking-wider text-ed-dark mt-1 uppercase">Sweet-Sesame Dressing</p>
            <p class="text-[12px] text-ed-dark mt-1.5 leading-relaxed uppercase font-geomanist-bold">Clementine, edamame, crispy chickpeas, carrots, avocado, cherry tomatoes, sesame seeds, mesclun, batavia</p>
          </div>

          <div class="menu-item">
            <div class="flex items-baseline justify-between gap-2">
              <button type="button" class="salad-name-btn text-left font-cardinal text-ed-green text-[20px] md:text-[48px] uppercase leading-[22px] md:leading-[40px] hover:text-ed-yellow transition-colors cursor-pointer bg-transparent border-none p-0" data-salad-id="big-crispy" data-price="15.90">Big <br/> Crispy</button>
              <span class="font-cardinal text-ed-green text-[18px] md:text-[48px]">15.90</span>
