    <div class="max-w-3xl mx-auto text-center">
      <p class="font-cardinal text-ed-red text-[28px] md:text-[38px] lg:text-[44px] leading-tight">
        Ultra-gourmet salads, 100% homemade
      </p>
      <p class="mt-3 md:mt-4 font-geomanist-bold text-ed-green text-[14px] md:text-[16px] uppercase tracking-[0.2em]">
        Made with top-quality ingredients
      </p>
      <div class="w-16 h-[3px] bg-ed-red/40 mx-auto mt-6 md:mt-8"></div>
    </div>
  </section>

