    </div>
    <!-- Mobile slide-out menu -->
    <div id="mobile-nav" class="fixed left-0 top-[56px] z-30 w-0 overflow-x-hidden h-[calc(100vh-56px)] bg-ed-green flex flex-col justify-center items-center gap-8 transition-[width] duration-300 ease-out md:hidden">
      <a href="https://elledees.zelty-order.fr/" target="_blank" rel="noopener noreferrer" class="mobile-nav-link font-geomanist-bold uppercase text-ed-yellow text-[26px] sm:text-[30px] whitespace-nowrap hover:text-white transition-colors">Click & Collect</a>
      <a href="#menu" class="mobile-nav-link font-geomanist-bold uppercase text-ed-yellow text-[26px] sm:text-[30px] whitespace-nowrap hover:text-white transition-colors">Menu</a>
      <a href="#aboutus" class="mobile-nav-link font-geomanist-bold uppercase text-ed-yellow text-[26px] sm:text-[30px] whitespace-nowrap hover:text-white transition-colors">About Us</a>
      <a href="#contact" class="mobile-nav-link font-geomanist-bold uppercase text-ed-yellow text-[26px] sm:text-[30px] whitespace-nowrap hover:text-white transition-colors">Contact</a>
    </div>
  </header>

  <!-- Hero section -->
  <section
    id="hero"
    class="relative w-full min-h-[70vh] md:min-h-screen py-20 md:py-0"
  >
    <img
      src="/images/hero.webp"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
    >
    <div class="absolute inset-0 bg-black/20" aria-hidden="true"></div>
    <div class="relative z-10 flex flex-col items-center justify-center h-full min-h-[70vh] md:min-h-screen gap-5 px-5">
      <h1 class="font-cardinal text-[60px] text-center xl:text-left md:text-[130px] xl:text-[130px] mx-auto text-white leading-[50px] md:leading-[110px] xl:leading-[110px] uppercase max-w-[980px] mb-12 md:mb-20">
        Massively healthy & incredibly fresh
      </h1>
      <a
        href="https://elledees.zelty-order.fr/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-[175px] h-[47px] md:w-[275px] md:h-[57px] flex items-center justify-center text-ed-green bg-white text-[12px] md:text-[18px] font-semibold uppercase rounded-[54px] hover:bg-ed-pink hover:text-ed-red transition-all duration-175"
      >
        Click & Collect
      </a>
    </div>
  </section>

  <!-- Tagline -->
