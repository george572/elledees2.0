          <div class="flex items-baseline justify-between gap-2">
            <h3 id="salad-sheet-title" class="font-cardinal text-ed-dark text-[20px] md:text-[28px] leading-tight"></h3>
            <p id="salad-sheet-price" class="font-cardinal text-ed-green text-[18px] md:text-[20px] flex-shrink-0"></p>
          </div>
          <h4 class="font-cardinal text-ed-dark text-[13px] md:text-[16px] mt-2 md:mt-4 mb-1 md:mb-2">Nutrition Info</h4>
          <div id="salad-sheet-nutrition" class="grid grid-cols-2 md:grid-cols-1 gap-x-4 gap-y-0.5 md:gap-y-1.5 text-[12px] md:text-[14px] text-ed-dark/70 font-geomanist-bold md:space-y-0">
            <!-- filled by JS -->
          </div>
          <a id="salad-sheet-order" href="https://elledees.zelty-order.fr/" target="_blank" rel="noopener noreferrer" class="mt-3 md:mt-6 inline-flex h-[40px] md:h-[44px] items-center justify-center px-6 md:px-8 bg-ed-green text-white text-[12px] md:text-[13px] font-geomanist-bold uppercase tracking-wide rounded-full hover:bg-ed-green/90 transition-colors flex-shrink-0">Order</a>
        </div>
      </div>
    </div>
    <button type="button" id="salad-sheet-close" class="absolute top-2 right-3 md:top-3 md:right-4 w-8 h-8 md:w-10 md:h-10 flex items-center justify-center rounded-full bg-ed-dark/10 text-ed-dark hover:bg-ed-dark/20 transition-colors" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <script>
    var SALAD_DATA = {
      'ave-cesar': { image: '/images/ave-cesar.webp', name: 'Ave Cesar', nutrition: { calories: '480 kcal', protein: '14g', carbs: '36g', fat: '28g', fiber: '12g' } },
      'tangerine-crunch': { image: '/images/amore-mio.webp', name: 'Tangerine Crunch', nutrition: { calories: '450 kcal', protein: '16g', carbs: '40g', fat: '24g', fiber: '10g' } },
      'big-crispy': { image: '/images/big-crispy.webp', name: 'Big Crispy', nutrition: { calories: '380 kcal', protein: '22g', carbs: '28g', fat: '18g', fiber: '6g' } },
      'super-sour': { image: '/images/amore-mio.webp', name: 'Super Sour', nutrition: { calories: '410 kcal', protein: '15g', carbs: '35g', fat: '24g', fiber: '9g' } },
      'mexican-dream': { image: '/images/amore-mio.webp', name: 'Mexican Dream', nutrition: { calories: '470 kcal', protein: '20g', carbs: '38g', fat: '26g', fiber: '11g' } },
      'amore-mio': { image: '/images/amore-mio.webp', name: 'Amore Mio', nutrition: { calories: '420 kcal', protein: '18g', carbs: '42g', fat: '22g', fiber: '8g' } },
      'buffalo-bill': { image: '/images/ave-cesar.webp', name: 'Buffalo Bill', nutrition: { calories: '520 kcal', protein: '24g', carbs: '28g', fat: '32g', fiber: '5g' } },
      'veggie-madness': { image: '/images/amore-mio.webp', name: 'Veggie Madness', nutrition: { calories: '390 kcal', protein: '16g', carbs: '34g', fat: '22g', fiber: '12g' } },
      'french-riviera': { image: '/images/ave-cesar.webp', name: 'French Riviera', nutrition: { calories: '460 kcal', protein: '26g', carbs: '32g', fat: '24g', fiber: '4g' } },
      'habibi-yallah': { image: '/images/amore-mio.webp', name: 'Habibi Yallah', nutrition: { calories: '440 kcal', protein: '12g', carbs: '48g', fat: '20g', fiber: '10g' } },
      'dolce-vita': { image: '/images/amore-mio.webp', name: 'Dolce Vita', nutrition: { calories: '280 kcal', protein: '10g', carbs: '28g', fat: '14g', fiber: '5g' } },
      'oriental-garden': { image: '/images/amore-mio.webp', name: 'Oriental Garden', nutrition: { calories: '260 kcal', protein: '9g', carbs: '30g', fat: '12g', fiber: '6g' } },
      'baby-crispy': { image: '/images/big-crispy.webp', name: 'Baby Crispy', nutrition: { calories: '220 kcal', protein: '14g', carbs: '18g', fat: '10g', fiber: '4g' } }
    };

    function openSaladCard(saladId, price) {
      var data = SALAD_DATA[saladId];
      if (!data) return;
      var sheet = document.getElementById('salad-sheet');
      var backdrop = document.getElementById('salad-sheet-backdrop');
      var imgEl = document.getElementById('salad-sheet-image');
      var titleEl = document.getElementById('salad-sheet-title');
      var priceEl = document.getElementById('salad-sheet-price');
      var nutritionEl = document.getElementById('salad-sheet-nutrition');
      var orderEl = document.getElementById('salad-sheet-order');
      if (!sheet || !backdrop || !imgEl || !titleEl || !priceEl || !nutritionEl || !orderEl) return;
      imgEl.src = data.image;
      imgEl.alt = data.name;
      titleEl.textContent = data.name;
      priceEl.textContent = price + '\u20AC';
      nutritionEl.innerHTML = [
        '<div class="flex justify-between"><span>Calories</span><span>' + data.nutrition.calories + '</span></div>',
        '<div class="flex justify-between"><span>Protein</span><span>' + data.nutrition.protein + '</span></div>',
        '<div class="flex justify-between"><span>Carbs</span><span>' + data.nutrition.carbs + '</span></div>',
        '<div class="flex justify-between"><span>Fat</span><span>' + data.nutrition.fat + '</span></div>',
        '<div class="flex justify-between"><span>Fiber</span><span>' + data.nutrition.fiber + '</span></div>'
      ].join('');
      backdrop.style.visibility = 'visible';
      backdrop.style.opacity = '1';
      backdrop.setAttribute('aria-hidden', 'false');
      sheet.style.bottom = '0';
      document.body.style.overflow = 'hidden';
    }

    function closeSaladCard() {
      var sheet = document.getElementById('salad-sheet');
      var backdrop = document.getElementById('salad-sheet-backdrop');
      if (!sheet || !backdrop) return;
      backdrop.style.visibility = 'hidden';
      backdrop.style.opacity = '0';
      backdrop.setAttribute('aria-hidden', 'true');
      sheet.style.bottom = '-100vh';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.salad-name-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = this.getAttribute('data-salad-id');
        var price = this.getAttribute('data-price');
        if (id && price) openSaladCard(id, price);
      });
    });
    var saladBackdrop = document.getElementById('salad-sheet-backdrop');
    var saladSheetClose = document.getElementById('salad-sheet-close');
    if (saladBackdrop) saladBackdrop.addEventListener('click', closeSaladCard);
    if (saladSheetClose) saladSheetClose.addEventListener('click', closeSaladCard);

    function switchMenuTab(tabName) {
      document.querySelectorAll('.menu-tab').forEach(function(t) {
        t.classList.toggle('active', t.getAttribute('data-tab') === tabName);
      });
      document.querySelectorAll('.menu-panel').forEach(function(p) {
        p.classList.toggle('active', p.id === 'panel-' + tabName);
      });
    }

    function switchLocation(btn) {
      document.querySelectorAll('.location-chip').forEach(function(c) {
        c.classList.remove('active');
      });
      btn.classList.add('active');
    }

    function toggleNutrition(btn) {
      var panel = btn.closest('.nutrition-panel') || btn.closest('.salad-card').querySelector('.nutrition-panel');
      if (!panel) return;
      panel.classList.toggle('translate-y-full');
      panel.classList.toggle('translate-y-0');
    }

    (function() {
      var burger = document.getElementById('burger-btn');
      var mobileNav = document.getElementById('mobile-nav');
      var mobileLinks = document.querySelectorAll('.mobile-nav-link');
      var langDisplay = document.getElementById('lang-display');
      var langDisplayMob = document.getElementById('lang-display-mob');
      var langToggle = document.getElementById('lang-toggle');

      if (burger && mobileNav) {
        burger.addEventListener('click', function() {
          var isOpen = mobileNav.classList.contains('open');
          mobileNav.classList.toggle('open', !isOpen);
          burger.classList.toggle('open', !isOpen);
          burger.setAttribute('aria-expanded', !isOpen);
          document.body.style.overflow = isOpen ? '' : 'hidden';
        });
        mobileLinks.forEach(function(link) {
          link.addEventListener('click', function() {
            mobileNav.classList.remove('open');
            burger.classList.remove('open');
            burger.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          });
        });
      }

      var lang = (function() {
        try { return localStorage.getItem('lang') || 'en'; } catch (e) { return 'en'; }
      })();
      function setLang(l) {
        lang = l;
        try { localStorage.setItem('lang', l); } catch (e) {}
        if (langDisplay) langDisplay.textContent = l.toUpperCase();
        if (langDisplayMob) langDisplayMob.textContent = l.toUpperCase();
      }
      setLang(lang);
      if (langToggle) {
        langToggle.addEventListener('click', function() {
          setLang(lang === 'en' ? 'fr' : 'en');
        });
      }
    })();

  </script>
</body>
</html>
