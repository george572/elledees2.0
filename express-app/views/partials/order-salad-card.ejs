<% var pills = [
  { label: 'Cal', value: s.nutrition.calories, unit: 'kcal' },
  { label: 'Protein', value: s.nutrition.protein, unit: 'g' },
  { label: 'Carbs', value: s.nutrition.carbs, unit: 'g' },
  { label: 'Fat', value: s.nutrition.fat, unit: 'g' },
  { label: 'Fiber', value: s.nutrition.fiber, unit: 'g' },
]; %>
<article class="bg-card text-card-foreground flex w-full min-w-0 max-w-full flex-shrink-0 flex-col self-start overflow-hidden rounded-[1.5rem] border border-border shadow-md md:w-[340px] md:max-w-[340px]">
  <div class="relative h-52 w-full overflow-hidden">
    <img src="<%= s.image %>" alt="<%= s.name %>" class="absolute inset-0 h-full w-full object-cover">
    <% if (s.tag) { %>
      <span class="absolute left-3 top-3 rounded-full bg-ed-red px-3 py-1 text-xs font-semibold text-white"><%= s.tag %></span>
    <% } %>
  </div>

  <div class="flex w-full min-w-0 flex-col items-start justify-start gap-2 p-5">
    <div class="flex w-full max-w-full flex-col gap-1 text-left">
      <div class="flex w-full min-w-0 items-start justify-between gap-3">
        <h2 class="min-w-0 flex-1 text-balance text-xl font-bold leading-snug text-foreground"><%= s.name %></h2>
        <span class="shrink-0 rounded-full bg-ed-green px-2.5 py-1 text-base font-bold text-white shadow-sm">$<%= s.price.toFixed(2) %></span>
      </div>
      <p class="text-sm leading-snug text-muted-foreground"><%= s.desc %></p>
    </div>

    <div class="w-full border-t border-border"></div>

    <button
      type="button"
      class="nutrition-toggle flex w-full max-w-full items-center justify-between gap-2 rounded-lg bg-secondary px-3 py-2 text-left text-[10px] font-semibold uppercase tracking-widest text-muted-foreground transition-colors hover:bg-secondary/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      aria-expanded="false"
    >
      <span>Nutrition info</span>
      <svg class="nutrition-chevron h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-300 ease-out will-change-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <div class="nutrition-collapsible w-full max-w-full">
      <div class="nutrition-collapsible-inner">
        <div class="flex flex-wrap gap-1.5 pb-0 pt-1">
          <% pills.forEach(function(p) { %>
            <div class="flex min-w-[56px] flex-col items-center gap-0.5 rounded-xl bg-muted px-3 py-2">
              <span class="text-sm font-semibold text-foreground">
                <%= p.value %><span class="text-xs font-normal text-muted-foreground"><%= p.unit %></span>
              </span>
              <span class="text-[10px] font-medium uppercase tracking-wide text-muted-foreground"><%= p.label %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <button type="button" class="w-full max-w-full rounded-xl bg-ed-red py-2.5 text-sm font-semibold text-white transition-all hover:opacity-90 active:scale-95">Add to Order</button>
  </div>
</article>
